# Local Cloudflare Pages Functions Secrets (.dev.vars)
# Copy this file to ".dev.vars" for local `wrangler pages dev` testing.
# NEVER commit ".dev.vars" to GitHub.

# Required cryptographic secrets (use two DIFFERENT 32+ char random strings)
SESSION_SECRET=""
CREDENTIAL_ENCRYPTION_KEY=""

# Admin Username & Password (local Wrangler dev - never commit .dev.vars)
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
ADMIN_FIREBASE_EMAIL=""
ADMIN_FIREBASE_PASSWORD=""

# Public WhatsApp click-to-chat number (digits only with country code)
ADMIN_WHATSAPP_NUMBER="201550324450"

# Persistent Web Push VAPID keys (generate via `npx web-push generate-vapid-keys`)
VAPID_SUBJECT="mailto:support@crovo.space"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Optional cron dispatch secret
PUSH_CRON_SECRET=""
