# Server Environment & Port
NODE_ENV=development
PORT=3000

# Security Secrets (Required in production - use strong random 32+ character strings)
SESSION_SECRET=""
CREDENTIAL_ENCRYPTION_KEY=""

# Admin Dashboard Credentials (Required in production - do not leave defaults)
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# Public WhatsApp Click-to-Chat Number (digits only with country code, no tokens/API needed)
ADMIN_WHATSAPP_NUMBER="201550324450"

# Free Standard Web Push (VAPID)
# Leave empty to auto-generate free VAPID keys in SQLite settings, or supply your own persistent keys:
VAPID_SUBJECT="mailto:support@crovo.space"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Optional secret to trigger due 3-day push notifications from a free external cron webhook (POST /api/push/cron-dispatch)
PUSH_CRON_SECRET=""

# ----------------------------------------------------------------------------
# Cloudflare Pages + D1 Deployment Variables
# Configure via Cloudflare Dashboard -> Workers & Pages -> Settings -> Environment Variables
# OR via: npx wrangler pages secret put SESSION_SECRET
# Required for production Pages Functions:
# - SESSION_SECRET
# - CREDENTIAL_ENCRYPTION_KEY
# - ADMIN_USERNAME
# - ADMIN_PASSWORD
# - DB binding configured in wrangler.toml ([[d1_databases]] binding = "DB")
# ----------------------------------------------------------------------------

