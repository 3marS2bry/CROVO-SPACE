# Server Environment & Port
NODE_ENV=development
PORT=3000

# Firebase Cloud Firestore (Project Settings -> Firebase Config)
FIREBASE_PROJECT_ID="sincere-impact-wbvhw"
FIREBASE_DATABASE_ID="ai-studio-crovospace-2e8ccbb9-ef49-4649-ad68-54f754bd8410"
FIREBASE_API_KEY=""

# Security Secrets (Required in production - use TWO DIFFERENT strong random 32+ character strings)
SESSION_SECRET=""
CREDENTIAL_ENCRYPTION_KEY=""

# Admin Panel Username & Password Login (configure in Cloudflare Dashboard / .dev.vars - NEVER commit real values)
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
# Optional: link password admin login automatically to a Firebase Email/Password admin account
ADMIN_FIREBASE_EMAIL=""
ADMIN_FIREBASE_PASSWORD=""

# Public WhatsApp Click-to-Chat Number (digits only with country code)
ADMIN_WHATSAPP_NUMBER="201550324450"

# Free Standard Web Push (VAPID)
# Generate persistent keys via: npx web-push generate-vapid-keys
VAPID_SUBJECT="mailto:support@crovo.space"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Optional cron dispatch secret (for POST /api/push/cron-dispatch)
PUSH_CRON_SECRET=""

# ----------------------------------------------------------------------------
# Cloudflare Pages + Firebase Deployment Variables
# Configure via Cloudflare Dashboard -> Workers & Pages -> Settings -> Environment Variables
# OR via: npx wrangler pages secret put SESSION_SECRET
# Required for production Pages Functions:
# - SESSION_SECRET
# - CREDENTIAL_ENCRYPTION_KEY
# - VAPID_PUBLIC_KEY
# - VAPID_PRIVATE_KEY
# - RATE_LIMIT_KV binding configured in wrangler.toml
# ----------------------------------------------------------------------------
